# Kopiera till .env.local för lokal utveckling. Checka aldrig in riktiga värden.
# Allt med prefixet EXPO_PUBLIC_ byggs in i appen och är PUBLIKT – lägg aldrig hemligheter här.
# Staging/produktion: värdena sätts som EAS Environment Variables, inte i filer.

EXPO_PUBLIC_APP_ENV=development

# Från `pnpm db:start` (lokal Supabase). Använd din dators LAN-IP för att nå den från en fysisk telefon.
EXPO_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxx
