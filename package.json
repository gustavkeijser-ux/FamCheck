{
  "name": "famcheck",
  "private": true,
  "description": "FamCheck \u2013 familjens gemensamma kontrollcenter",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "lint": "eslint . --max-warnings=0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "pnpm -r --parallel typecheck",
    "test": "pnpm -r test",
    "check:secrets": "node scripts/check-secrets.mjs",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset",
    "db:test": "supabase test db",
    "db:lint": "supabase db lint --schema public,private --level warning --fail-on warning",
    "gen:types": "node scripts/gen-types.mjs",
    "check:types-drift": "node scripts/gen-types.mjs --check",
    "test:integration": "pnpm --filter @famcheck/mobile test:integration"
  },
  "devDependencies": {
    "@famcheck/config": "workspace:*",
    "eslint": "^9.39.5",
    "prettier": "^3.9.9",
    "supabase": "^2.119.0",
    "typescript": "~6.0.3"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "supabase",
      "unrs-resolver"
    ]
  }
}
